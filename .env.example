# Consensus layer -- 1,000 credits/month free, no card. https://app.tavily.com
TAVILY_API_KEY=

# Community layer -- free for non-commercial (100 QPM with OAuth).
# Register a "script" app at https://www.reddit.com/prefs/apps
# NOTE: manual approval since late 2025; silent rejection is possible.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=research-mcp/0.1 (personal research tool)

# Social layer -- full X archive, $0.15/1k tweets. https://twitterapi.io
# Swappable: GetXAPI $0.05/1k, TwitterAPIs $0.04/1k, Sorsa from $0.02/1k
X_API_KEY=
# X_API_BASE=https://api.twitterapi.io

# Where the corpus lives (default ~/.research-mcp/corpus.db)
# RESEARCH_CORPUS=

# Tracing -- optional. One Langfuse trace per tool call, one observation per
# provider query. Free cloud tier at https://cloud.langfuse.com, or self-host.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
